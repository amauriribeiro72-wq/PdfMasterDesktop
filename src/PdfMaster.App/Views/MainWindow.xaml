<Window x:Class="PdfMaster.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PdfMaster.App.Views"
        xmlns:vm="clr-namespace:PdfMaster.App.ViewModels"
        Title="PDF Master Pro - Edição Desktop (Offline &amp; Seguro)"
        Height="820" Width="1240"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <!-- Conteúdo Principal no Padrão Ribbon Desktop Suite -->
        <views:BatchProcessingView DataContext="{Binding BatchProcessing}" />
    </Grid>
</Window>
