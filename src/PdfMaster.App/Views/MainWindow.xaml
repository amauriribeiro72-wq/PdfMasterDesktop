<ui:FluentWindow x:Class="PdfMaster.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:PdfMaster.App.Views"
        xmlns:vm="clr-namespace:PdfMaster.App.ViewModels"
        Title="PDF Master Pro"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Nativa Windows 11 -->
        <ui:TitleBar
            Grid.Row="0"
            Title="PDF Master Pro - Edição Desktop (Offline &amp; Seguro)" />

        <!-- Conteúdo Principal -->
        <views:BatchProcessingView Grid.Row="1" DataContext="{Binding BatchProcessing}" />
    </Grid>
</ui:FluentWindow>
