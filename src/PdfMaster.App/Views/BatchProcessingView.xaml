<UserControl x:Class="PdfMaster.App.Views.BatchProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1280"
             Background="#F3F4F6"
             AllowDrop="True"
             Drop="OnListDrop"
             DragOver="OnListDragOver">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Linha 0: Barra Superior e Faixa Ribbon Completa -->
            <RowDefinition Height="Auto"/>
            <!-- Linha 1: Workspace Central (Miniaturas Retráteis + Grande Leitor de PDF) -->
            <RowDefinition Height="*"/>
            <!-- Linha 2: Barra de Status Inferior e Controles de Leitura -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- LINHA 0: BARRA DE TÍTULO, ABAS E RIBBON    -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Linha Superior: Botão Arquivos, Acesso Rápido e Abas Ribbon -->
                    <RowDefinition Height="Auto"/>
                    <!-- Linha Inferior: Barra de Ferramentas da Aba Ativa -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LINHA 1 DE TOPO: BOTÃO "≡ ARQUIVOS" + ABAS -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="8,6,12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botão Vermelho Arredondado "≡ Arquivos" -->
                        <Button Grid.Column="0" Command="{Binding AddFilesCommand}"
                                Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                                Padding="14,6" BorderThickness="0" Margin="0,0,10,0" ToolTip="Abrir Menu de Arquivos">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="≡ " FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="Arquivos" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Ícones de Acesso Rápido (Abrir, Salvar, Imprimir, Desfazer, Refazer) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Command="{Binding AddFilesCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Abrir Arquivo PDF (Ctrl+O)">
                                <TextBlock Text="📁" FontSize="14"/>
                            </Button>
                            <Button Command="{Binding OpenLastOutputFileCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Salvar / Abrir Resultado">
                                <TextBlock Text="💾" FontSize="14"/>
                            </Button>
                            <Button Command="{Binding PrintDocumentCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Imprimir Documento (Ctrl+P)">
                                <TextBlock Text="🖨️" FontSize="14"/>
                            </Button>
                            <Border Width="1" Height="16" Background="#E5E7EB" Margin="6,0"/>
                            <Button Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Desfazer">
                                <TextBlock Text="↩️" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Refazer">
                                <TextBlock Text="↪️" FontSize="12"/>
                            </Button>
                        </StackPanel>

                        <!-- Faixa de Abas Ribbon Temáticas (Pílula Vermelha na Aba Ativa) -->
                        <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedRibbonTab}"
                                    BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem" BasedOn="{StaticResource RibbonTabItemStyle}"/>
                            </TabControl.ItemContainerStyle>
                            <TabItem Header="Início"/>
                            <TabItem Header="Editar"/>
                            <TabItem Header="Anotar"/>
                            <TabItem Header="Página"/>
                            <TabItem Header="Formulário"/>
                            <TabItem Header="Converter"/>
                            <TabItem Header="Proteger"/>
                            <TabItem Header="Ferramentas"/>
                            <TabItem Header="Ajuda"/>
                        </TabControl>

                        <!-- Indicador à Direita (Offline & Segurança) -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding SetDefaultPdfReaderCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Definir como Leitor Padrão do Windows">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️ " FontSize="12"/>
                                    <TextBlock Text="Leitor Padrão" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Border Background="#ECFDF5" CornerRadius="10" Padding="8,3" Margin="6,0,0,0">
                                <TextBlock Text="100% Offline" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LINHA 2 DO RIBBON: BARRA DE FERRAMENTAS ESPECÍFICA DE CADA ABA -->
                <Border Grid.Row="1" Background="#FAFAFA" Padding="8,6" MinHeight="62" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- ABA 0: INÍCIO -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRibbonTab}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Command="{Binding OpenStampEditorCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏷️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Carimbar" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding QuickSignImageCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✍️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Assinatura" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenUnlockModalCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔓" FontSize="16" HorizontalAlignment="Center" Foreground="#DC2626"/>
                                    <TextBlock Text="Remover Senha" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#E5E7EB" Margin="6,0"/>

                            <!-- Modos de Visualização e Zoom -->
                            <Button Command="{Binding ResetZoomCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="1 Página" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding FitToWidthCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="↔️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Largura" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="➖" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Zoom -" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="2,0">
                                <TextBlock Text="{Binding ZoomPercentageText}" FontSize="11" FontWeight="Bold" Width="42" TextAlignment="Center"/>
                            </Border>

                            <Button Command="{Binding ZoomInCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="➕" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Zoom +" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#E5E7EB" Margin="6,0"/>

                            <Button Command="{Binding ApplyTextHighlightCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🖍️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Realçar" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CropPagesCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✂️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Cortar" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExportTextReportCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📝" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Extrair Texto" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OcrPdfCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="OCR Pesquisável" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding PrintDocumentCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🖨️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Imprimir" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ABA 1: EDITAR -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRibbonTab}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Command="{Binding AddTextMarkupCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="T" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Caixa de Texto" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding QuickSignImageCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🖼️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Adicionar Imagem" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ApplyWatermarkCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💧" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Marca de Água" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AddPageNumbersCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="#️⃣" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Número de Página" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- CARIMBO ADMINISTRATIVO COM ALÇAS (DESTAQUE) -->
                            <Button Command="{Binding OpenStampEditorCommand}" Style="{StaticResource RibbonActionButtonStyle}"
                                    Background="#DCFCE7">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏷️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Carimbo (Pago, Quitado...)" FontSize="11" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding QuickSignImageCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✍️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Assinatura" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding FlattenDocumentCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📜" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Achatar Camadas" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ABA 2: ANOTAR -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRibbonTab}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Command="{Binding ApplyTextHighlightCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🖍️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Realçar" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ApplyTextUnderlineCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="U" TextDecorations="Underline" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sublinhar" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ApplyTextStrikeoutCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rasurar" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AddTextMarkupCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nota Adesiva" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ABA 3: PÁGINA (A ABA DESTACADA PELO USUÁRIO) -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRibbonTab}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Caixa de Seleção Rápida de Páginas (eg. 1, 8, 9-12) -->
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding PageSelectionRangeInput, UpdateSourceTrigger=PropertyChanged}"
                                             Width="110" Padding="4,3" FontSize="11" ToolTip="Ex: 1, 3, 5-8"/>
                                    <Button Command="{Binding ApplyPageSelectionRangeCommand}" Padding="6,2" Margin="3,0,0,0" Content="✔"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedPagesCountDisplay, StringFormat='Selecionado {0}'}" FontSize="10" Foreground="#0066CC" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Width="1" Height="32" Background="#E5E7EB" Margin="4,0"/>

                            <Button Command="{Binding DeleteSelectedVisualPagesCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🗑️" FontSize="16" HorizontalAlignment="Center" Foreground="#DC2626"/>
                                    <TextBlock Text="Eliminar" FontSize="11" HorizontalAlignment="Center" Foreground="#DC2626" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExtractSelectedVisualPagesCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📤" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Extrair" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CropPagesCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✂️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Cortar Páginas" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding Rotate270Command}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="↺" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rodar para Esquerda" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding Rotate90Command}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="↻" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rodar para Direita" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AddFilesCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="➕" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Inserir" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#E5E7EB" Margin="6,0"/>

                            <Button Command="{Binding MergePdfCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📑" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Mesclar PDF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SplitPdfCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✂️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Dividir PDF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding GenerateNUpCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📖" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Modo Folheto" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ABA 4: FORMULÁRIO -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRibbonTab}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Command="{Binding LoadFormFieldsCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📝" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ler Campos AcroForms" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding FillFormFieldsCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✍️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Preencher Campos" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding FlattenDocumentCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📜" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Achatar Formulário" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ABA 5: CONVERTER -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRibbonTab}" Value="5">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Command="{Binding ConvertPdfToImagesCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🖼️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PDF para PNG/JPG" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExportTextReportCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PDF para Word/RTF" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExportTextReportCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📝" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PDF para TXT" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#E5E7EB" Margin="6,0"/>

                            <Button Command="{Binding ConvertImagesToPdfCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📑" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Imagem para PDF" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OcrPdfCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="OCR Pesquisável" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ABA 6: PROTEGER (COM REMOÇÃO DE SENHA EM DESTAQUE) -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRibbonTab}" Value="6">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- BOTÃO REMOVER SENHA / FATURAS DE CARTÃO (DESTAQUE) -->
                            <Button Command="{Binding OpenUnlockModalCommand}" Style="{StaticResource RibbonActionButtonStyle}"
                                    Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔓" FontSize="18" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Remover Senha (Faturas)" FontSize="11" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ProtectWithPasswordCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Palavra-passe" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SignDocumentCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✍️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Assinar ICP-Brasil" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding LoadCertificatesCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🎖️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Gestor de Certificados" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ApplyRedactionCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⬛" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Redigir / Tarjamento" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SanitizeMetadataCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🧹" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sanitizar Metadados" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ABA 7: FERRAMENTAS -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRibbonTab}" Value="7">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Command="{Binding CompressPdfCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🗜️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Comprimir PDF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding RepairPdfCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🩹" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Reparar PDF" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CompareDocumentsCommand}" Style="{StaticResource RibbonActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚖️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Comparar Documentos" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ABA 8: AJUDA -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRibbonTab}" Value="8">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Command="{Binding SetDefaultPdfReaderCommand}" Style="{StaticResource RibbonActionButtonStyle}"
                                    Background="#EFF6FF">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" Foreground="#1D4ED8"/>
                                    <TextBlock Text="Definir como Leitor Padrão do Windows" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#E5E7EB" Margin="6,0"/>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PDF Master Pro v2.5 Desktop" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="100% Offline • Sem envio para servidores • Segurança Total" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- LINHA 1: WORKSPACE CENTRAL (MINIATURAS + LEITOR PRINCIPAL) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Coluna 0: Painel Lateral Retrátil de Miniaturas / Arquivos -->
                <ColumnDefinition Width="Auto"/>
                <!-- Coluna 1: O Grande Leitor Central de PDF -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL LATERAL RETRÁTIL (MINIATURAS DE PÁGINAS) -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0"
                    Width="240" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Topo do Painel Lateral -->
                    <Border Grid.Row="0" Padding="10,8" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📑 Miniaturas" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding PageThumbnails.Count, StringFormat=' ({0})'}" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding ToggleSidebarCommand}" HorizontalAlignment="Right" Padding="4,2" Content="✕" ToolTip="Recolher Painel"/>
                        </Grid>
                    </Border>

                    <!-- Ações Rápidas de Seleção -->
                    <Border Grid.Row="1" Padding="8,4" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding SelectAllPagesCommand}" Padding="4,2" FontSize="11" Margin="1,0" Content="Todas"/>
                            <Button Grid.Column="1" Command="{Binding ClearPageSelectionCommand}" Padding="4,2" FontSize="11" Margin="1,0" Content="Limpar"/>
                            <Button Grid.Column="2" Command="{Binding InvertPageSelectionCommand}" Padding="4,2" FontSize="11" Margin="1,0" Content="Inverter"/>
                        </Grid>
                    </Border>

                    <!-- Lista Rolável de Miniaturas das Páginas -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PageThumbnails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="10,6" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Imagem da Miniatura Clicável -->
                                            <Button Grid.Row="0" Command="{Binding DataContext.OpenZoomPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                <Image Source="{Binding ThumbnailSource}" Stretch="Uniform" Height="140"/>
                                            </Button>

                                            <!-- Rodapé da Miniatura com Checkbox e Número -->
                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Content="{Binding PageNumber, StringFormat='Pág. {0}'}" FontSize="11" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Botão de Ação Rápida no Rodapé do Painel Lateral -->
                    <Border Grid.Row="3" Padding="8" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                        <Button Command="{Binding OpenStampEditorCommand}" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="8,6" Content="🏷️ Carimbar Página"/>
                    </Border>
                </Grid>
            </Border>

            <!-- GRANDE LEITOR E VISUALIZADOR CENTRAL DE PDF -->
            <Grid Grid.Column="1" Background="#525659">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra Vertical de Alternância do Painel Lateral -->
                <Button Command="{Binding ToggleSidebarCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Panel.ZIndex="10"
                        Background="#FFFFFF" Padding="6,4" ToolTip="Expandir / Recolher Painel Lateral">
                    <TextBlock Text="📑 Miniaturas" FontSize="11" FontWeight="SemiBold"/>
                </Button>

                <!-- Área Rolável de Leitura Central -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <!-- Folha do Documento PDF Renderizada -->
                        <Border Background="White" CornerRadius="2" Padding="0"
                                Visibility="{Binding CurrentViewPageImage, Converter={StaticResource BoolToVisConverter}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.4" ShadowDepth="4"/>
                            </Border.Effect>

                            <Image Source="{Binding CurrentViewPageImage}" Stretch="Uniform">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
                                </Image.LayoutTransform>
                            </Image>
                        </Border>

                        <!-- Tela Inicial Quando Nenhum Arquivo Está Aberto -->
                        <Border Background="White" CornerRadius="12" Padding="40,30" MaxWidth="520">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📑" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="PDF Master Pro" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111827"/>
                                <TextBlock Text="Visualizador &amp; Editor Completo de PDF 100% Offline" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,20"/>
                                <Button Command="{Binding AddFilesCommand}" Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="14" Padding="20,10" Content="📁 Abrir Arquivo PDF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ou dê dois cliques em qualquer arquivo PDF no seu computador" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- LINHA 2: BARRA DE STATUS INFERIOR          -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Controles de Página à Esquerda -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Status Central -->
                    <ColumnDefinition Width="*"/>
                    <!-- Controles de Zoom à Direita -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navegação de Páginas -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding FirstPageCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Primeira Página" Content="|◀"/>
                    <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Página Anterior" Content="◀"/>
                    <Border Background="#F3F4F6" CornerRadius="4" Padding="8,2" Margin="4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageDisplay}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Button Command="{Binding NextPageCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Próxima Página" Content="▶"/>
                    <Button Command="{Binding LastPageCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Última Página" Content="▶|"/>
                </StackPanel>

                <!-- Mensagem de Status Central -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#374151" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Controles de Zoom à Direita -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource RibbonActionButtonStyle}" Content="➖" ToolTip="Reduzir Zoom"/>
                    <Slider Width="90" Minimum="0.3" Maximum="3.0" Value="{Binding ZoomFactor}" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Command="{Binding ZoomInCommand}" Style="{StaticResource RibbonActionButtonStyle}" Content="➕" ToolTip="Aumentar Zoom"/>
                    <Border Background="#F3F4F6" CornerRadius="4" Padding="6,2" Margin="4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZoomPercentageText}" FontSize="11" FontWeight="Bold" Width="40" TextAlignment="Center"/>
                    </Border>
                    <Button Command="{Binding FitToWidthCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Ajustar à Largura" Content="↔️"/>
                    <Button Command="{Binding FitToPageCommand}" Style="{StaticResource RibbonActionButtonStyle}" ToolTip="Ajustar à Página" Content="↕️"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- MODAL 1: DESBLOQUEIO E REMOÇÃO DE SENHA (FATURAS CARTÃO) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#90000000" Visibility="{Binding IsUnlockModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#FFFFFF" CornerRadius="12" Padding="24" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔓" FontSize="26" Margin="0,0,8,0" Foreground="#DC2626"/>
                        <TextBlock Text="Remover Senha do Documento" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Ideal para faturas de cartão de crédito e documentos bancários protegidos. Digite a senha uma única vez para salvar uma versão 100% desprotegida na mesma pasta."
                               FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Senha do Documento (ex: CPF ou data de nascimento):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding UnlockModalPassword, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseUnlockModalCommand}" Padding="10" Content="Cancelar"/>
                        <Button Grid.Column="2" Command="{Binding ConfirmUnlockModalCommand}" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="10" Content="🔓 Desbloquear Agora"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL 2: EDITOR VISUAL DE CARIMBOS COM ALÇAS (PAGO...)    -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#B0000000" Visibility="{Binding IsStampEditorOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#F9FAFB" CornerRadius="12" Margin="16" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="1" BorderBrush="#D1D5DB">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barra Superior: Seleção de Carimbos, Rotação, Opacidade e Ações -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#E5E7EB">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Linha 1: Título, Navegação de Páginas e Botões de Ação -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏷️ Editor de Carimbo Visual" FontSize="15" FontWeight="Bold" Foreground="#111827"/>
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock Text="Arraste o carimbo livremente e puxe a alça vermelha para redimensionar" FontSize="11" Foreground="#1D4ED8" FontWeight="Medium"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Navegador de Página -->
                                    <Button Command="{Binding PreviousStampPageCommand}" Content="◀" Padding="8,4" Margin="0,0,4,0" ToolTip="Página Anterior"/>
                                    <TextBlock Text="{Binding StampPageIndicator}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0" FontSize="12"/>
                                    <Button Command="{Binding NextStampPageCommand}" Content="▶" Padding="8,4" Margin="4,0,14,0" ToolTip="Próxima Página"/>

                                    <!-- Botões Principais -->
                                    <Button Command="{Binding ApplyInteractiveStampCommand}" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="0,0,8,0" Content="✔ Aplicar Carimbo"/>
                                    <Button Command="{Binding CloseStampEditorCommand}" Background="#F3F4F6" Padding="12,6" Content="✕ Fechar"/>
                                </StackPanel>
                            </Grid>

                            <!-- Linha 2: Modelos de Carimbo em Botões Rápidos + Sliders -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Carimbos Rápidos -->
                                <ItemsControl Grid.Column="0" ItemsSource="{Binding AvailableStamps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectStampCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,5,0" Padding="7,3" FontSize="11" FontWeight="Bold">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🏷️ " FontSize="10"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Grid.Column="1" HorizontalAlignment="Left" Command="{Binding UploadCustomStampCommand}" Margin="4,0,0,0" Padding="8,3" FontSize="11" Content="📁 Subir Meu PNG..."/>

                                <!-- Ajustes de Rotação, Tamanho e Opacidade -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Rotação:" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <Button Command="{Binding SetStampRotationCommand}" CommandParameter="-12" Content="-12°" Padding="4,2" FontSize="10" Margin="0,0,2,0"/>
                                    <Button Command="{Binding SetStampRotationCommand}" CommandParameter="0" Content="0°" Padding="4,2" FontSize="10" Margin="0,0,2,0"/>
                                    <Button Command="{Binding SetStampRotationCommand}" CommandParameter="12" Content="+12°" Padding="4,2" FontSize="10" Margin="0,0,8,0"/>

                                    <TextBlock Text="Largura:" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <Slider Width="80" Minimum="60" Maximum="450" Value="{Binding StampWidth}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <TextBlock Text="Opacidade:" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <Slider Width="60" Minimum="0.4" Maximum="1.0" Value="{Binding StampOpacity}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Área Central: Imagem da Página + Canvas do Carimbo -->
                    <Border Grid.Row="1" Background="#E5E7EB" CornerRadius="8" Padding="10" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Imagem Renderizada da Página do PDF -->
                                <Image Source="{Binding StampEditorPageImage}"
                                       Width="{Binding CanvasRenderWidth}"
                                       Height="{Binding CanvasRenderHeight}"
                                       Stretch="Fill"/>

                                <!-- Canvas Interativo Sobreposto à Página -->
                                <Canvas x:Name="StampCanvas"
                                        Width="{Binding CanvasRenderWidth}"
                                        Height="{Binding CanvasRenderHeight}"
                                        Background="Transparent"
                                        ClipToBounds="True">

                                    <!-- Carimbo Interativo Arrastável e Redimensionável -->
                                    <Border Canvas.Left="{Binding StampX}"
                                            Canvas.Top="{Binding StampY}"
                                            Width="{Binding StampWidth}"
                                            Height="{Binding StampHeight}"
                                            BorderThickness="1.5"
                                            BorderBrush="#2563EB"
                                            CornerRadius="4"
                                            Background="#102563EB"
                                            Cursor="SizeAll"
                                            MouseLeftButtonDown="Stamp_MouseLeftButtonDown"
                                            MouseMove="Stamp_MouseMove"
                                            MouseLeftButtonUp="Stamp_MouseLeftButtonUp">

                                        <Grid>
                                            <!-- Imagem do Carimbo Escolhido -->
                                            <Image Source="{Binding CurrentStampPreviewImage}"
                                                   Stretch="Fill"
                                                   Opacity="{Binding StampOpacity}">
                                                <Image.RenderTransform>
                                                    <RotateTransform Angle="{Binding StampRotation}"
                                                                     CenterX="{Binding StampHalfWidth}"
                                                                     CenterY="{Binding StampHalfHeight}"/>
                                                </Image.RenderTransform>
                                            </Image>

                                            <!-- Alça Canto Superior Esquerdo -->
                                            <Border Width="10" Height="10" Background="#2563EB" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0"/>

                                            <!-- Alça Canto Superior Direito -->
                                            <Border Width="10" Height="10" Background="#2563EB" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"/>

                                            <!-- Alça Canto Inferior Esquerdo -->
                                            <Border Width="10" Height="10" Background="#2563EB" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5"/>

                                            <!-- Alça Principal de Redimensionamento (Canto Inferior Direito) -->
                                            <Border Width="14" Height="14" Background="#DC2626" BorderBrush="White" BorderThickness="2" CornerRadius="3"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-7,-7"
                                                    Cursor="SizeNWSE"
                                                    ToolTip="Arraste esta alça vermelha para redimensionar o carimbo"
                                                    MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                                                    MouseMove="ResizeHandle_MouseMove"
                                                    MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
                                        </Grid>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Barra Inferior de Dicas -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="💡 Clique e arraste o carimbo para os espaços em branco da página. Arraste a alça vermelha no canto para ajustar o tamanho exato."
                                   FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Text="O arquivo carimbado será salvo na mesma pasta com o sufixo _carimbado.pdf"
                                   FontSize="11" Foreground="#059669" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL 3: ZOOM DE PÁGINA EM ALTA RESOLUÇÃO                -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsPreviewZoomOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="White" CornerRadius="10" Padding="16" MaxWidth="850" MaxHeight="750" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Visualização em Alta Resolução" FontWeight="Bold" FontSize="14"/>
                        <Button HorizontalAlignment="Right" Command="{Binding CloseZoomPreviewCommand}" Padding="8,4" Content="✕ Fechar"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image Source="{Binding PreviewZoomImage}" Stretch="Uniform"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
